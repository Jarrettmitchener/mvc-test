@model IEnumerable<mvc_test.Data.CarRecord>

@{
    ViewData["Title"] = "Index";
}

<style>
    /* fixes the datatables.net css override of table-bordered */
    table.dataTable.table-bordered th,
    table.dataTable.table-bordered td {
        border: var(--bs-border-width) solid var(--bs-border-color) !important;
    }
</style>

<h1>Index</h1>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<link href="~/lib/datatables/datatables.min.css" rel="stylesheet" />
<script src="~/lib/datatables/datatables.min.js"></script>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-bordered" id="recordsTable">
    <thead class="table-info">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RecordType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Repairer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Notes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RecordType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Repairer)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Notes)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
@* <script src="~/js/records.js"></script> *@
<script src="~/js/dt/basic.js"></script>
<script src="~/js/record1.js"></script>