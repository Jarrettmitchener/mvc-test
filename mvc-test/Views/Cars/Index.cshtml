    </tbody>
</table>
<script src="~/js/dt/basic.js"></script>
<script>
    const table = initTable('#carTable',{
    serverSide: true,
    ajax: {
        url: '/Cars/GetCars',
        type: 'POST'
    },
    columns: [
        { title: 'Actions', data: 'id', render: 
        function(data){
            return createBasicEditorButtons(data)
            }
        },
        { name: 'Year', data: 'year' },
        { name: 'Make', data: 'make' },
        { name: 'Model',   data: 'model' },
        { name: 'Active',   data: 'active' },
        { name: 'Notes',   data: 'notes' },
    ]
    });
</script>